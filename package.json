{
  "name": "dresses-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run start --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:auth-database": "npm run test:auth-database --workspace=api",
    "test:tenancy": "npm run test:tenancy --workspace=api",
    "lint": "npm run lint --workspace=api",
    "migration:run": "npm run migration:run --workspace=api",
    "migration:revert": "npm run migration:revert --workspace=api",
    "migration:show": "npm run migration:show --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true,
    "argon2@0.45.2": true
  }
}
